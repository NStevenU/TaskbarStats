<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>TaskbarStats</RootNamespace>
    <AssemblyName>TaskbarStats</AssemblyName>

    <!-- Keep the resident footprint small -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.svg" LogicalName="icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\app.png" LogicalName="app.png" />
    <EmbeddedResource Include="Assets\Fonts\label.ttf" LogicalName="font.label.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE;NOTICE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="licenses\**" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
